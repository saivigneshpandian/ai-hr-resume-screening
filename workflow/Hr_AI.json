    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert HR assistant specialized in extracting and structuring information from resumes. Your task is to analyze resume text and extract key details accurately.\n\nWhen extracting information:\n- Be precise and extract exactly what's mentioned in the resume\n- For arrays (Work Experience, Internship, Projects, Certifications, Languages, Interests), include all items found\n- Use \"Not mentioned\" if a field is not present in the resume\n- Maintain professional formatting\n- Extract education details including institution name, degree, and years\n\nAlways return ONLY a valid JSON object with no additional text, code blocks, or markdown formatting.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=I have the following resume text:\n{{ $json.content.parts[0].text }}\n\nPlease extract the following fields and return ONLY a valid JSON object.\nDo not include any code, comments, markdown, or explanations.\nReturn exactly this structure, with values filled from the resume:\n\n{\n  \"Full_Name\": \"Full Name here\",\n  \"Phone\": \"Phone here\",\n  \"Email\": \"Email here\",\n  \"Education\": \"Education here\",\n  \"Skills\": \"Skills here\",\n  \"Work_Experience\": [\"WorkExperience1\", \"WorkExperience2\"],\n  \"Internship\": [\"Internship 1\", \"Internship 2\"],\n  \"Projects\": [\"Project 1\", \"Project 2\"],\n  \"Certifications\": [\"Certification1\", \"Certification2\"],\n  \"Languages\": [\"Language1\", \"Language2\"],\n  \"Interests\": [\"Interest1\", \"Interest2\"]\n}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
      "position": [
        16,
        -80
      ],
      "id": "6c77c31e-a871-4ece-ac8e-14587e7f65e6",
